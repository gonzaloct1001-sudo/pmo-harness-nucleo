  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/herramientas/py.sh\" \"${CLAUDE_PROJECT_DIR:-.}/herramientas/hooks/inicio_sesion.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/herramientas/py.sh\" \"${CLAUDE_PROJECT_DIR:-.}/herramientas/hooks/proteger_confidenciales.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/herramientas/py.sh\" \"${CLAUDE_PROJECT_DIR:-.}/herramientas/hooks/validar_edicion.py\""
          }
        ]
